{
    "name": "icd10-prototype/app",
    "description": "Austrian ICD-10 BMASGPK 2026 educational prototype: PHP evaluation service and API (RULEBASE-0.1 / MODELBASE-0.1).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "php-webdriver/webdriver": "^1.15",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Icd10Prototype\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Icd10Prototype\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
